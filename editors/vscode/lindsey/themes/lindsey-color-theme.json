    "scrollbarSlider.activeBackground": "#344d58",
    "breadcrumb.foreground": "#4e6874",
    "breadcrumb.focusForeground": "#c2d6e0",
    "gitDecoration.modifiedResourceForeground": "#c0992a",
    "gitDecoration.deletedResourceForeground": "#ec6056",
    "gitDecoration.untrackedResourceForeground": "#77b670",
    "gitDecoration.ignoredResourceForeground": "#4e6874",
    "gitDecoration.conflictingResourceForeground": "#d46abb",
    "diffEditor.insertedTextBackground": "#77b67020",
    "diffEditor.removedTextBackground": "#ec605620",
