#!/usr/bin/env bash
# sshcheck — test connectivity to all configured SSH hosts
# Usage: sshcheck [timeout_seconds]
set -euo pipefail

TIMEOUT="${1:-5}"
CONFIG="${HOME}/.ssh/config"
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
RESET='\033[0m'
if [[ ! -f "$CONFIG" ]]; then
    echo "No SSH config found at $CONFIG" >&2
    exit 1
fi
HOSTS=$(grep -i '^Host ' "$CONFIG" | awk '{print $2}' | grep -v '\*')
echo "Testing SSH hosts (timeout: ${TIMEOUT}s)..."
echo ""
printf "  %-30s %s\n" "Host" "Status"
printf "  %-30s %s\n" "----" "------"
while IFS= read -r host; do
    if ssh -o ConnectTimeout="$TIMEOUT" \
           -o BatchMode=yes \
           -o StrictHostKeyChecking=no \
           "$host" true 2>/dev/null; then
        printf "  ${GREEN}%-30s ✓ OK${RESET}\n" "$host"
    else
        EXIT=$?
        if [[ $EXIT -eq 255 ]]; then
            printf "  ${RED}%-30s ✗ Unreachable${RESET}\n" "$host"
        else
            printf "  ${YELLOW}%-30s ⚠ Auth failed (exit $EXIT)${RESET}\n" "$host"
        fi
    fi
done <<< "$HOSTS"
